# Modo de fuente: demo o live. El valor por defecto debe seguir siendo demo.
SOC_SOURCE_MODE=demo

# Clave HMAC externa. Use un valor local distinto y no lo versione.
SOC_PSEUDONYM_KEY=valor_ficticio_cambiar_localmente

# PostgreSQL institucional: completar solo dentro de la red UTPL autorizada.
SOC_DB_DSN=postgresql://usuario_solo_lectura:valor_ficticio@servidor_autorizado:5432/base_autorizada
SOC_DB_VIEW=esquema.vista_adfs_autorizada
SOC_DB_TIME_COLUMN=event_time
SOC_DB_ID_COLUMN=event_id
SOC_DB_CONNECT_TIMEOUT_SECONDS=10
SOC_DB_STATEMENT_TIMEOUT_SECONDS=30
SOC_DB_RETRY_ATTEMPTS=3
SOC_DB_RETRY_DELAY_SECONDS=2

# Checkpoint inicial opcional; ambos valores deben configurarse juntos.
SOC_INITIAL_CHECKPOINT_TIME_UTC=
SOC_INITIAL_CHECKPOINT_EVENT_ID=

# El MVP solo registra entregas internas en soc_inbox.
SOC_NOTIFICATION_MODE=soc_inbox
SOC_LOG_LEVEL=INFO

# Mantener local para demos. Production exige HTTPS, OIDC y configuración validada.
SOC_ENV=local
# Solo dominios exactos, sin comodines; predeterminado: host de SOC_PUBLIC_URL.
SOC_ALLOWED_HOSTS=

# Clave opcional para firmar cursores; si se omite se usa la clave OIDC o HMAC local.
# No guardar valores reales en Git. Rotarla invalida enlaces a páginas anteriores.
SOC_CURSOR_SECRET=

# Destino del menú Dashboard (sin credenciales). En Docker se adapta al puerto de Grafana.
SOC_GRAFANA_DASHBOARDS_URL=http://127.0.0.1:3000/dashboards

# Investigación asistida, solo por solicitud autenticada. Sin MCP ni acciones automáticas.
SOC_AI_ENABLED=false
SOC_AI_PROVIDER=openai
# Modelo de su cuenta que admita Responses API + Structured Outputs; no se selecciona solo.
SOC_AI_MODEL=
OPENAI_API_KEY=
# Clave Fernet externa distinta a HMAC. Custodiarla junto a respaldos cifrados.
SOC_INVESTIGATION_IP_KEY=
SOC_INVESTIGATION_CAPTURE_IP=false
# Opcional: solo consulta IP públicas a AbuseIPDB, nunca reporta ni bloquea.
SOC_IP_REPUTATION_ENABLED=false
ABUSEIPDB_API_KEY=
