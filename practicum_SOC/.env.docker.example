# Genere .env.docker con tools/setup_docker.py. Este ejemplo no contiene secretos.
SOC_POSTGRES_PASSWORD=
SOC_APP_PASSWORD=
SOC_GRAFANA_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
SOC_PSEUDONYM_KEY=
# Ruta relativa al directorio del proyecto, o absoluta con /.
SOC_CSV_PATH=./data/INTEGRATIONDB_integrt_security_event_logs1.csv
# Solo el worker live recibe estas variables. No rellene con datos en Git.
SOC_DB_DSN=
SOC_DB_VIEW=
SOC_DB_TIME_COLUMN=event_time
SOC_DB_ID_COLUMN=event_id
SOC_INITIAL_CHECKPOINT_TIME_UTC=
SOC_INITIAL_CHECKPOINT_EVENT_ID=

# Identidad LOCAL de operadores del SOC, independiente de usuarios ADFS.
SOC_OIDC_CLIENT_SECRET=
SOC_IDP_DB_PASSWORD=
SOC_IDP_ADMIN_PASSWORD=
SOC_BOOTSTRAP_ADMIN_PASSWORD=
SOC_BOOTSTRAP_ANALYST_PASSWORD=
SOC_IDP_PORT=8080

# Investigación por solicitud; igual clave de investigación en web, worker live y worker IA.
SOC_AI_ENABLED=false
SOC_AI_PROVIDER=openai
SOC_AI_MODEL=
OPENAI_API_KEY=
SOC_INVESTIGATION_IP_KEY=
SOC_INVESTIGATION_CAPTURE_IP=false
SOC_IP_REPUTATION_ENABLED=false
ABUSEIPDB_API_KEY=
