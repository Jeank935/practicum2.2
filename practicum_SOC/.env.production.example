# Copiar a .env.production (ignorado en Git), generar secretos y sustituir dominios.
# No usar directamente: los valores vacíos hacen que producción rechace el arranque.
SOC_ENV=production
SOC_AUTH_MODE=oidc
SOC_PUBLIC_URL=https://soc.example.edu
SOC_ALLOWED_HOSTS=soc.example.edu
SOC_OIDC_ISSUER=https://identity.example.edu/realms/soc
SOC_OIDC_INTERNAL_ORIGIN=
SOC_OIDC_CLIENT_ID=soc-web
SOC_OIDC_CLIENT_SECRET=
SOC_CURSOR_SECRET=
SOC_STORAGE_BACKEND=postgres
SOC_STORAGE_HOST=postgres
SOC_STORAGE_PORT=5432
SOC_STORAGE_DB=soc
SOC_STORAGE_USER=soc_app
SOC_STORAGE_PASSWORD=
# disable solo para la base aislada en la misma red Docker privada.
# Para un servidor separado: verify-full y archivo CA montado en modo lectura.
SOC_STORAGE_SSLMODE=disable
SOC_STORAGE_SSLROOTCERT=
# El worker necesita su clave HMAC y la conexión institucional de SOLO LECTURA.
# Mantener la clave HMAC existente: rotarla cambia los seudónimos.
SOC_PSEUDONYM_KEY=
SOC_DB_DSN=
SOC_DB_VIEW=
